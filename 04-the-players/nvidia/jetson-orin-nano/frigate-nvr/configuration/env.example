# ============================================================
# Frigate Jetson environment
#
# Copy:
#   cp .env.example .env
#
# Then edit .env.
#
# IMPORTANT:
#   Do not commit .env to Git.
# ============================================================

TZ=America/Los_Angeles

# TensorRT model to generate on the Jetson.
YOLO_MODELS=yolov7-320
USE_FP16=true


# ------------------------------------------------------------
# EmpireTech
# ------------------------------------------------------------

FRIGATE_EMPIRETECH_USER=frigate
FRIGATE_EMPIRETECH_PASSWORD=CHANGE_ME


# ------------------------------------------------------------
# Reolink Video Doorbell WiFi
# ------------------------------------------------------------

FRIGATE_REOLINK_USER=frigate
FRIGATE_REOLINK_PASSWORD=CHANGE_ME


# ------------------------------------------------------------
# MQTT
# ------------------------------------------------------------
#
# Use the IP/DNS name of your existing MQTT broker.
# Example:
#
# FRIGATE_MQTT_HOST=192.168.50.20
#
FRIGATE_MQTT_HOST=CHANGE_ME
FRIGATE_MQTT_USER=frigate
FRIGATE_MQTT_PASSWORD=CHANGE_ME
